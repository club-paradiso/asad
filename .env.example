# ---------------------------------------------------------------------------
# tong-yuck environment configuration
#
# Every value here is OPTIONAL. With an empty .env.local the app still runs
# fully in DEMO MODE (scripted streaming, no network, no microphone) and in
# BROWSER MODE (on-device Web Speech API, no key required).
#
# Copy to `.env.local` and fill in only what you need. Never commit .env.local.
#
# For a genuinely zero-cost live setup, see the FREE LIVE PRESET below and
# docs/free-tier-deployment.md.
# ---------------------------------------------------------------------------

# ===========================================================================
# FREE LIVE PRESET — real live interpretation at $0
# ===========================================================================
# Uncomment these three lines, add one free Gemini key, and you have live
# Korean→English interpretation with no paid API anywhere in the path.
#
#   STT_PROVIDER=webspeech
#   LLM_ROUTING_MODE=auto-free
#   GEMINI_API_KEY=your-free-key
#
# Limitations and the privacy tradeoff are documented in
# docs/free-tier-deployment.md — read it before using this for a real service.
# Gemini's FREE tier may use prompts and responses to improve Google products,
# including human review. Set LLM_PRIVACY_MODE=strict to exclude such
# providers, or use LLM_ROUTING_MODE=local to send nothing at all.

# ---------------------------------------------------------------------------
# Speech to text
# ---------------------------------------------------------------------------
# demo      | scripted stream, no key, no mic, works offline   (default)
# webspeech | browser-native SpeechRecognition (ko-KR), no key, no server, $0
# deepgram  | Deepgram streaming WebSocket (nova-3, language=ko)
# openai    | OpenAI realtime transcription WebSocket
STT_PROVIDER=demo

DEEPGRAM_API_KEY=
# Required to mint short-lived browser keys. Without it the configured key is
# passed to the browser instead — see docs/privacy.md.
DEEPGRAM_PROJECT_ID=
DEEPGRAM_STT_MODEL=nova-3

OPENAI_STT_MODEL=gpt-live-transcribe

# ---------------------------------------------------------------------------
# Interpretation routing
# ---------------------------------------------------------------------------
# local      | never call a cloud model; deterministic local interpreter only
# auto-free  | prefer verified free tiers, degrade to local        (default)
# pinned     | always the provider named by LLM_PROVIDER
# reliable   | prefer the configured paid provider
LLM_ROUTING_MODE=auto-free

# standard | any configured provider may be used
# strict   | exclude providers that may train on free-tier submissions
LLM_PRIVACY_MODE=standard

# auto-free NEVER escalates to a paid API unless this is explicitly true.
# A free provider failing must not silently start costing money.
LLM_ALLOW_PAID_FALLBACK=false

# Counter Mode routes to open-weight models first (Groq's gpt-oss, OpenRouter's
# Llama). Defaults to true — it is what Counter Mode was asked for, and the
# providers serving open weights also happen to have the better data-use
# posture on a free tier. It is a preference, not a filter: if no open-weight
# provider is configured the counter still translates, using whatever is.
LLM_COUNTER_PREFER_OPEN=true

# ---------------------------------------------------------------------------
# Provider keys — set only the ones you have
# ---------------------------------------------------------------------------
# Free tier available. Best quota headroom for continuous interpretation.
# Privacy: free tier may be used to improve Google products (human review).
GEMINI_API_KEY=

# Free tier available. Does NOT train on your data on either tier.
# Caveat: 6,000 tokens/min free-tier limit is below what full-context live
# interpretation needs, so tong-yuck automatically uses a compact context.
GROQ_API_KEY=

# Free tier available but only ~50 requests/day on an unfunded account, which
# lasts roughly seven minutes of continuous speech. Best used as a fallback or
# for evaluation rather than as the live default.
OPENROUTER_API_KEY=

# Paid. Also used for STT when STT_PROVIDER=openai.
OPENAI_API_KEY=

# Paid.
ANTHROPIC_API_KEY=

# ---------------------------------------------------------------------------
# Model overrides — all optional; sensible defaults ship in the code
# ---------------------------------------------------------------------------
# Defaults verified 2026-08-24. Override if a model is deprecated or you
# prefer a different one; no code change is ever required.
GEMINI_LLM_MODEL=gemini-3.5-flash-lite
GROQ_LLM_MODEL=openai/gpt-oss-120b
OPENROUTER_LLM_MODEL=meta-llama/llama-3.3-70b-instruct:free
OPENAI_LLM_MODEL=gpt-4.1-mini
ANTHROPIC_LLM_MODEL=claude-sonnet-5

# ---------------------------------------------------------------------------
# Phase 1 compatibility (still supported)
# ---------------------------------------------------------------------------
# Setting LLM_PROVIDER without LLM_ROUTING_MODE keeps Phase 1 behaviour: the
# named provider is pinned. LLM_API_KEY is applied to that provider. Prefer the
# per-provider keys above for new deployments.
# LLM_PROVIDER=
# LLM_API_KEY=

# ---------------------------------------------------------------------------
# Bible
# ---------------------------------------------------------------------------
# reference-only | normalise + display the reference, never the verse text (default)
# public-domain  | fetch public-domain English text (WEB/KJV) via bible-api.com
# api-bible      | scripture.api.bible (requires a key AND a licensed translation)
BIBLE_PROVIDER=reference-only
BIBLE_API_KEY=
BIBLE_ID=
# Copyrighted translations (NIV/ESV/NLT/NASB/NKJV) require your own licence:
# with `reference-only` tong-yuck shows the reference and never invents wording.
BIBLE_TRANSLATION=WEB
