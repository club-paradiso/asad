# ---------------------------------------------------------------------------
# tong-yuck environment configuration
#
# Every value here is OPTIONAL. With an empty .env.local the app still runs
# fully in DEMO MODE (scripted streaming, no network, no microphone) and in
# BROWSER MODE (on-device Web Speech API, no key required).
#
# Copy to `.env.local` and fill in only what you need. Never commit .env.local.
#
# For a genuinely zero-cost live setup, see the FREE LIVE PRESET below and
# docs/free-tier-deployment.md.
# ---------------------------------------------------------------------------

# ===========================================================================
# RECOMMENDED PRODUCTION PRESET — Deepgram + OpenRouter
# ===========================================================================
# What to use for a real service you intend to trust. Copy this block, fill in
# two keys, and run `npm run health:openrouter` before the service to prove the
# gateway actually answers.
#
#   STT_PROVIDER=deepgram
#   DEEPGRAM_API_KEY=
#   DEEPGRAM_PROJECT_ID=            # needed to mint short-lived browser keys
#   DEEPGRAM_STT_MODEL=nova-3
#
#   LLM_ROUTING_MODE=pinned
#   LLM_PROVIDER=openrouter
#   OPENROUTER_API_KEY=
#   OPENROUTER_PRIMARY_MODEL=google/gemini-3.7-flash
#
#   OPENROUTER_PROVIDER_SORT=latency
#   OPENROUTER_DATA_COLLECTION=deny
#   OPENROUTER_REQUIRE_PARAMETERS=true
#   OPENROUTER_ALLOW_PROVIDER_FALLBACKS=true
#
#   APP_ACCESS_KEY=                 # see PROTECTING A DEPLOYED APP below
#
# A deployment carrying a billed OPENROUTER_API_KEY is a public endpoint
# unless you gate it. Read the PROTECTING A DEPLOYED APP section — it is the
# difference between a tool and a bill.

# ===========================================================================
# FREE LIVE PRESET — real live interpretation at $0
# ===========================================================================
# Uncomment these three lines, add one free Gemini key, and you have live
# Korean→English interpretation with no paid API anywhere in the path.
#
#   STT_PROVIDER=webspeech
#   LLM_ROUTING_MODE=auto-free
#   GEMINI_API_KEY=your-free-key
#
# Limitations and the privacy tradeoff are documented in
# docs/free-tier-deployment.md — read it before using this for a real service.
# Gemini's FREE tier may use prompts and responses to improve Google products,
# including human review. Set LLM_PRIVACY_MODE=strict to exclude such
# providers, or use LLM_ROUTING_MODE=local to send nothing at all.

# ---------------------------------------------------------------------------
# Speech to text
# ---------------------------------------------------------------------------
# demo      | scripted stream, no key, no mic, works offline   (default)
# webspeech | browser-native SpeechRecognition (ko-KR), no key, no server, $0
# deepgram  | Deepgram streaming WebSocket (nova-3, language=ko)
# openai    | OpenAI realtime transcription WebSocket
STT_PROVIDER=demo

DEEPGRAM_API_KEY=
# Required to mint short-lived browser keys. Without it the configured key is
# passed to the browser instead — see docs/privacy.md.
DEEPGRAM_PROJECT_ID=
DEEPGRAM_STT_MODEL=nova-3

OPENAI_STT_MODEL=gpt-live-transcribe

# ---------------------------------------------------------------------------
# Interpretation routing
# ---------------------------------------------------------------------------
# local      | never call a cloud model; deterministic local interpreter only
# auto-free  | prefer verified free tiers, degrade to local        (default)
# pinned     | always the provider named by LLM_PROVIDER
# reliable   | prefer the configured paid provider
LLM_ROUTING_MODE=auto-free

# standard | any configured provider may be used
# strict   | exclude providers that may train on free-tier submissions
LLM_PRIVACY_MODE=standard

# auto-free NEVER escalates to a paid API unless this is explicitly true.
# A free provider failing must not silently start costing money.
LLM_ALLOW_PAID_FALLBACK=false

# Counter Mode routes to open-weight models first (Groq's gpt-oss, OpenRouter's
# Llama). Defaults to true — it is what Counter Mode was asked for, and the
# providers serving open weights also happen to have the better data-use
# posture on a free tier. It is a preference, not a filter: if no open-weight
# provider is configured the counter still translates, using whatever is.
LLM_COUNTER_PREFER_OPEN=true

# Providers you are on a BILLED plan for. Comma-separated; empty by default.
#
# An API key looks identical on either tier, so this cannot be detected — it is
# a declaration, and it is trusted. Two things change for a provider listed here:
#
#   1. Its free-tier quota stops being used as a local ceiling. Without this a
#      paid key gets throttled against limits it does not have, and the router
#      benches it as "quota nearly exhausted" while the account has plenty left.
#   2. Its PAID data-use posture applies. Gemini does not train on paid API
#      data, so LLM_PRIVACY_MODE=strict will admit it — which it cannot do
#      while every provider is judged by its free tier.
#
# Declaring a provider paid when it is not sends content to a training-capable
# tier while the interface says otherwise. Only list what you actually pay for.
# Note: a consumer Gemini/Google One AI subscription is NOT this — API billing
# is enabled separately, per project.
# LLM_PAID_TIER=gemini

# ---------------------------------------------------------------------------
# Provider keys — set only the ones you have
# ---------------------------------------------------------------------------
# Free tier available. Best quota headroom for continuous interpretation.
# Privacy: free tier may be used to improve Google products (human review).
GEMINI_API_KEY=

# Free tier available. Does NOT train on your data on either tier.
# Caveat: 6,000 tokens/min free-tier limit is below what full-context live
# interpretation needs, so tong-yuck automatically uses a compact context.
GROQ_API_KEY=

# The recommended production gateway. One key reaches every model, and the
# provider-routing controls below are what make it suitable for live work
# rather than merely available.
#
# NOTE ON THE FREE TIER: an unfunded OpenRouter account allows ~50 requests a
# day, which is about seven minutes of continuous speech. Fund the account for
# live use; the free tier is for evaluation.
OPENROUTER_API_KEY=

# Paid. Also used for STT when STT_PROVIDER=openai.
OPENAI_API_KEY=

# Paid.
ANTHROPIC_API_KEY=

# ---------------------------------------------------------------------------
# OpenRouter gateway
# ---------------------------------------------------------------------------
# OpenRouter is a ROUTER, not a vendor, and these controls are the difference
# between "it responds" and "it is fit for a live service". They are sent on
# every request.

# The live model, pinned for the session. Pinned deliberately: switching model
# families between sentences drifts terminology and register, and the
# interpreter is the one who absorbs it mid-sentence.
#
# Latency is the binding constraint on this path, not raw capability — a fast
# Flash-class model that answers in under a second beats a stronger one that
# answers after the interpreter has already spoken.
#
# Model ids change on their own schedule. Nothing here requires a code change:
# run `npm run health:openrouter` to prove the id you set actually resolves and
# returns valid structured output.
#
# WANT AN OPEN-SOURCE MODEL INSTEAD? The default above is proprietary. Which
# open-weight models OpenRouter serves free ROTATES, so this file cannot list
# them honestly — ask the deployment instead:
#
#   GET /api/models/open-weight        (same-origin; also on /diagnostics)
#
# It reads OpenRouter's public catalogue and returns only models that are free,
# open-weight, capable of JSON-schema output, and free of always-on reasoning
# — the four things a live turn here actually needs. It hands back a
# copy-paste `OPENROUTER_PRIMARY_MODEL=` line. Verify with
# `npm run health:openrouter` before a service, as always.
#
# Note the quota reality (docs/free-tier-deployment.md): an UNFUNDED OpenRouter
# account is capped at ~50 requests/day, which a 45-minute sermon exhausts in
# about four minutes. Open weights fix the licence and privacy question, not
# the throughput one — credit the account, or run Counter Mode, which is
# turn-based and fits comfortably.
OPENROUTER_PRIMARY_MODEL=google/gemini-3.7-flash

# Ordering preference for upstream selection: latency | throughput | price.
# Live interpretation wants latency. A perfect answer that arrives after the
# moment has passed is worth nothing.
OPENROUTER_PROVIDER_SORT=latency

# deny | allow. Excludes upstreams that may retain or train on what is sent.
# LLM_PRIVACY_MODE=strict forces this to deny and says so rather than silently
# honouring `allow`.
OPENROUTER_DATA_COLLECTION=deny

# Zero data retention. Stricter than data_collection=deny: it also excludes
# upstreams that retain content transiently for abuse monitoring. Narrows the
# eligible pool considerably — if it leaves nothing, the turn FAILS visibly and
# names the constraint rather than quietly widening the policy.
OPENROUTER_ZDR=false

# Retry a failed upstream on another upstream serving the SAME model. This is
# not model roulette and does not threaten terminology consistency.
OPENROUTER_ALLOW_PROVIDER_FALLBACKS=true

# Exclude upstreams that do not support every parameter we send, rather than
# letting one silently drop `response_format` and answer in prose.
OPENROUTER_REQUIRE_PARAMETERS=true

# Optional explicit upstream allow/deny lists, comma-separated.
# OPENROUTER_PROVIDER_ONLY=
# OPENROUTER_PROVIDER_IGNORE=

# Optional second opinion on hard turns — wordplay, idiom, or a low-confidence
# primary answer. OFF by default: it costs latency and money.
#
# It can never delay what the interpreter sees. Escalation is attempted only
# with measured turn budget remaining, and its result is discarded rather than
# waited for. A late perfect translation is worse than a timely good one.
OPENROUTER_QUALITY_ESCALATION=false
OPENROUTER_QUALITY_MODEL=anthropic/claude-sonnet-5

# ---------------------------------------------------------------------------
# PROTECTING A DEPLOYED APP
# ---------------------------------------------------------------------------
# /api/interpret, /api/prep, /api/counter/message and /api/stt/token all spend
# money. Deployed without a gate they are public endpoints, and /api/stt/token
# is the worst of them — it mints recogniser credentials that outlive the
# request.
#
# Always on, no configuration needed: same-origin enforcement, body-size
# ceilings, server-issued session tokens, and per-session and per-address rate
# limits sized from the measured live workload.
#
# Set this for a private deployment and nothing paid answers without it. Any
# non-empty value works; it is a shared secret, not a password for an account.
# APP_ACCESS_KEY=

# SET THIS IF YOU DEPLOY TO VERCEL OR ANYTHING ELSE THAT RUNS MORE THAN ONE
# INSTANCE. Session tokens are signed with it, and it must be identical on
# every instance. Without it the signing key is random per process, a token
# minted by one instance fails on the next, and enforcing sessions would not
# make the deployment stricter — it would break it, continuously. So without a
# stable secret, session tokens degrade to keying rate limits per browser and
# stop gating requests. Same-origin and per-address limits still apply, and
# /diagnostics says which mode is in force.
#
# APP_ACCESS_KEY doubles as this when it is set, so a gated deployment needs
# nothing further.
# SESSION_SECRET=

# THE HONEST CAVEAT: rate limits live in the memory of one server instance. On
# Vercel, or anywhere else running more than one, the effective ceiling is the
# limit multiplied by the number of warm instances. That is a real bound, and
# it is not a global guarantee. For a hard ceiling, set a spend limit on the
# OpenRouter key itself.

# ---------------------------------------------------------------------------
# Model overrides — all optional; sensible defaults ship in the code
# ---------------------------------------------------------------------------
# Defaults verified 2026-08-24. Override if a model is deprecated or you
# prefer a different one; no code change is ever required.
GEMINI_LLM_MODEL=gemini-3.5-flash-lite
GROQ_LLM_MODEL=openai/gpt-oss-120b
OPENAI_LLM_MODEL=gpt-4.1-mini
ANTHROPIC_LLM_MODEL=claude-sonnet-5
# OpenRouter's model is OPENROUTER_PRIMARY_MODEL above. OPENROUTER_LLM_MODEL is
# the older spelling and is still read when the newer one is unset.

# ---------------------------------------------------------------------------
# Phase 1 compatibility (still supported)
# ---------------------------------------------------------------------------
# Setting LLM_PROVIDER without LLM_ROUTING_MODE keeps Phase 1 behaviour: the
# named provider is pinned. LLM_API_KEY is applied to that provider. Prefer the
# per-provider keys above for new deployments.
# LLM_PROVIDER=
# LLM_API_KEY=

# ---------------------------------------------------------------------------
# Bible
# ---------------------------------------------------------------------------
# reference-only | normalise + display the reference, never the verse text (default)
# public-domain  | fetch public-domain English text (WEB/KJV) via bible-api.com
# api-bible      | scripture.api.bible (requires a key AND a licensed translation)
BIBLE_PROVIDER=reference-only
BIBLE_API_KEY=
BIBLE_ID=
# Copyrighted translations (NIV/ESV/NLT/NASB/NKJV) require your own licence:
# with `reference-only` tong-yuck shows the reference and never invents wording.
BIBLE_TRANSLATION=WEB
