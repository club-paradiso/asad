{
  "name": "tong-yuck",
  "version": "0.1.0",
  "private": true,
  "description": "A real-time AI copilot for human interpreters.",
  "license": "MIT",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "npm run lint && npm run typecheck && npm test && npm run build && npm run smoke:llm && npm run soak -- --minutes 5",
    "icons": "node scripts/generate-icons.mjs",
    "shot": "node scripts/screenshot.mjs",
    "e2e": "node scripts/e2e-check.mjs",
    "e2e:live-fallback": "node scripts/e2e-live-fallback.mjs",
    "e2e:live-failure": "node scripts/e2e-live-failure.mjs",
    "e2e:live-quota-bypass": "node scripts/e2e-live-quota-bypass.mjs",
    "e2e:live-two-lane": "node scripts/e2e-live-two-lane.mjs",
    "bench:llm": "tsx scripts/bench-llm.mjs",
    "bench:gemini": "tsx scripts/bench-llm.mjs --only gemini --stdout markdown --no-write",
    "smoke:llm": "tsx scripts/smoke-llm.mjs",
    "bench:live": "tsx scripts/bench-live.mjs",
    "soak": "tsx scripts/soak.mjs",
    "soak:two-lane": "tsx scripts/soak-two-lane.mjs",
    "health:openrouter": "tsx scripts/health-openrouter.mjs",
    "measure:prompt": "tsx scripts/measure-prompt.mjs"
  },
  "dependencies": {
    "next": "^16.3.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "server-only": "^0.0.1",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.5.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "9.39.5",
    "eslint-config-next": "^16.3.4",
    "jsdom": "30.0.1",
    "jsqr": "^1.4.0",
    "playwright": "^1.63.0",
    "postcss": "8.5.28",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.13",
    "typescript": "6.0.3",
    "vitest": "5.0.0"
  }
}
