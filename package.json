{
  "name": "tong-yuck",
  "version": "0.1.0",
  "private": true,
  "description": "A real-time AI copilot for human interpreters.",
  "license": "MIT",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "npm run lint && npm run typecheck && npm test && npm run build && npm run smoke:llm && npm run soak -- --minutes 5",
    "icons": "node scripts/generate-icons.mjs",
    "shot": "node scripts/screenshot.mjs",
    "e2e": "node scripts/e2e-check.mjs",
    "bench:llm": "tsx scripts/bench-llm.mjs",
    "bench:gemini": "tsx scripts/bench-llm.mjs --only gemini --stdout markdown --no-write",
    "smoke:llm": "tsx scripts/smoke-llm.mjs",
    "bench:live": "tsx scripts/bench-live.mjs",
    "soak": "tsx scripts/soak.mjs"
  },
  "dependencies": {
    "next": "^16.3.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "server-only": "^0.0.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/react": "16.3.2",
    "@types/node": "22.18.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "5.0.2",
    "eslint": "9.39.5",
    "eslint-config-next": "^16.3.2",
    "jsdom": "26.1.0",
    "jsqr": "^1.4.0",
    "playwright": "^1.62.1",
    "postcss": "8.5.26",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.12",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  }
}
