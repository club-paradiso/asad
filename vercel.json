{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "github": {
    "silent": true
  },
  "env": {
    "STT_PROVIDER": "webspeech",
    "LLM_ROUTING_MODE": "reliable",
    "LLM_PROVIDER": "openrouter",
    "LLM_ALLOW_PAID_FALLBACK": "false",
    "LLM_LIVE_REQUIRE_SUSTAINABLE": "false",
    "LLM_COUNTER_PREFER_OPEN": "true",
    "LLM_COUNTER_PROVIDER": "gemini",
    "GEMINI_LLM_MODEL": "gemini-3.5-flash-lite",
    "OPENROUTER_PRIMARY_MODEL": "nex-agi/nex-n2.5-mini:free",
    "OPENROUTER_QUALITY_MODEL": "google/gemma-4-31b-it:free",
    "OPENROUTER_QUALITY_ESCALATION": "false",
    "OPENROUTER_PROVIDER_SORT": "latency",
    "OPENROUTER_DATA_COLLECTION": "deny",
    "OPENROUTER_ZDR": "false",
    "OPENROUTER_ALLOW_PROVIDER_FALLBACKS": "true",
    "OPENROUTER_REQUIRE_PARAMETERS": "true",
    "BIBLE_PROVIDER": "reference-only"
  }
}
